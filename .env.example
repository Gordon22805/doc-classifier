# Ключ Groq: https://console.groq.com/keys
# Регистрация бесплатная, модель ниже работает по бесплатному тарифу.
# Без ключа сервис запускается, но /predict отвечает 503.
GROQ_API_KEY=

# Заглушка уже рабочая, менять не обязательно.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Бесплатная текстовая модель Groq. Можно заменить на любую другую.
LLM_MODEL=llama-3.3-70b-versatile

# Необязательные настройки
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
MAX_TEXT_LENGTH=4000
MAX_TICKETS=50
