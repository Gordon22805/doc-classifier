# Ключ OmniRouter. Получите в панели OmniRouter и вставьте сюда.
OMNIROUTER_API_KEY=

# Адрес API OmniRouter из его документации, без /chat/completions на конце.
# Пример вида: https://<хост-omni>/api/v1
OMNIROUTER_BASE_URL=

# Имя модели, доступной через OmniRouter. Возьмите из списка моделей OmniRouter.
LLM_MODEL=

# Необязательные настройки
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
MAX_TEXT_LENGTH=4000
MAX_TICKETS=50
