# Ключ OpenRouter: https://openrouter.ai/keys
# Регистрация бесплатная, модель ниже работает по бесплатному тарифу.
# Без ключа сервис запускается, но /predict отвечает 503.
OPENROUTER_API_KEY=

# Заглушка уже рабочая, менять не обязательно.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Бесплатная текстовая модель OpenRouter. Можно заменить на любую другую.
LLM_MODEL=google/gemma-4-31b-it:free

# Необязательные настройки
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0
MAX_TEXT_LENGTH=4000
MAX_TICKETS=50
