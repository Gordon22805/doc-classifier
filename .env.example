# Скопируйте в .env и вставьте ключ.
# OCR: vision-модель через OpenRouter (OpenAI-совместимый API)
# Ключ: https://openrouter.ai/keys
OPENAI_API_KEY=
VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
VISION_BASE_URL=https://openrouter.ai/api/v1

# Альтернативы (раскомментируйте нужное):
# --- OpenAI ---
# VISION_MODEL=gpt-4o
# VISION_BASE_URL=
# --- Google Gemini (есть бесплатный тариф) ---
# VISION_MODEL=gemini-2.5-flash
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# --- Локальная модель (Ollama / LM Studio), ключ не нужен ---
# VISION_MODEL=qwen2.5vl:3b
# VISION_BASE_URL=http://127.0.0.1:11434/v1

# PDF Processing
PDF_RENDER_DPI=220
MAX_IMAGE_SIDE=3200
JPEG_QUALITY=95

# OCR Retry Configuration
OCR_TILED_RETRY_ENABLED=true
OCR_TILE_OVERLAP=0.18
OCR_BATCH_SIZE=2
OCR_GLOBAL_CONCURRENCY=4

# OCR Timeouts (seconds)
OCR_CONNECT_TIMEOUT=5
OCR_REQUEST_TIMEOUT=120
OCR_MAX_RETRIES=2

# Classification Configuration
MIN_CLASSIFICATION_SCORE=2
MIN_SCORE_MARGIN=2

# Archive Safety Limits
MAX_ARCHIVE_FILES=1000
MAX_FILE_SIZE_MB=100
MAX_TOTAL_UNPACK_SIZE_MB=500
MAX_NESTED_ARCHIVES=2

# Text Quality Thresholds
MIN_TEXT_LENGTH=10
MAX_REPLACEMENT_CHAR_RATIO=0.15
MIN_ALNUM_RATIO=0.3
MAX_REPEAT_LENGTH=10
MAX_CID_RATIO=0.1

# Application
HOST=0.0.0.0
PORT=8000
TEMP_DIR=./temp
UPLOAD_DIR=./uploads
RESULTS_DIR=./results
